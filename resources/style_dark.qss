/* ============================================================
   LocalLLM-GUI — ТЁМНАЯ ТЕМА
   ============================================================ */

QMainWindow, QWidget {
    font-family: "Inter", "Segoe UI", "Segoe UI Emoji", "Segoe UI Symbol", "SF Pro Display", sans-serif;
    font-size: 14px;
    color: #e6e8f2;
}

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1a1a1e, stop:0.5 #202026, stop:1 #1b2424);
}

QListWidget {
    background: rgba(40, 40, 48, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 6px;
    outline: none;
}

QListWidget::item { padding: 10px 12px; border-radius: 12px; color: #e6e8f2; }
QListWidget::item:hover { background: rgba(123, 168, 255, 0.18); }
QListWidget::item:selected { background: rgba(123, 168, 255, 0.32); color: #ffffff; }

QPushButton {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 13px;
    padding: 10px 16px;
    color: #e6e8f2;
    font-weight: 600;
}

QPushButton:hover {
    background: rgba(123, 168, 255, 0.18);
    border-color: rgba(123, 168, 255, 0.4);
}

QPushButton:disabled {
    opacity: 0.4;
    background: rgba(255, 255, 255, 0.04);
    color: #6a6a7a;
}

QPushButton#sendButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #8db6ff, stop:1 #6a97f2);
    color: #ffffff;
    border: none;
}

QPushButton#sendButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #9cc2ff, stop:1 #7ba8ff);
}

QPushButton#sendButton:disabled {
    background: rgba(120, 130, 160, 0.4);
    color: rgba(255, 255, 255, 0.5);
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 10px 12px;
    color: #e6e8f2;
    selection-background-color: rgba(123, 168, 255, 0.35);
}

QLineEdit:hover, QTextEdit:hover { background: rgba(255, 255, 255, 0.09); }
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid rgba(123, 168, 255, 0.6);
    background: rgba(255, 255, 255, 0.12);
}

QTextEdit#chatView {
    background: rgba(40, 40, 48, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 14px;
    font-size: 14.5px;
    color: #e6e8f2;
}

QComboBox {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 8px 12px;
    color: #e6e8f2;
    min-height: 24px;
}

QComboBox:hover { border-color: rgba(123, 168, 255, 0.5); }
QComboBox::drop-down { border: none; width: 24px; }

QComboBox QAbstractItemView {
    background: #2a2a32;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    color: #e6e8f2;
    selection-background-color: rgba(123, 168, 255, 0.28);
    padding: 4px;
}

QSlider { min-height: 24px; }

QSlider::groove:horizontal {
    height: 6px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #8db6ff, stop:1 #6a97f2);
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #6a97f2;
    width: 18px;
    height: 18px;
    margin: -8px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    border: 2px solid #4a7ad4;
    background: #f8fbff;
}

QSpinBox {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 8px 12px;
    color: #e6e8f2;
}

QLabel { color: #e6e8f2; background: transparent; }

QStatusBar {
    background: rgba(20, 20, 26, 0.7);
    color: #a0a2b4;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 4px 12px;
}

/* ТОНКАЯ ПОЛОСА ПРОКРУТКИ */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 6px 2px 6px 0;
}

QScrollBar::handle:vertical {
    background: rgba(157, 191, 255, 0.4);
    border-radius: 3px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(157, 191, 255, 0.7);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { height: 0px; background: transparent; }

QToolTip {
    background: #e6e8f2;
    color: #1c1d2b;
    border: none;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12.5px;
}

QWidget#dialogListWidget {
    background: rgba(40, 40, 48, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
}

QPushButton#newDialogButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #8db6ff, stop:1 #6a97f2);
    color: #ffffff;
    border: none;
    border-radius: 22px;
    padding: 10px 18px;
    font-weight: 700;
    font-size: 14px;
}

QLineEdit#searchField {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 8px 12px;
    color: #c8cade;
    font-size: 13px;
}

QLabel#groupHeader {
    color: #7a7d90;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 8px 6px 2px 6px;
}

QListWidget#dialogsList { background: transparent; border: none; padding: 0; }

QListWidget#dialogsList::item {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 14px;
    padding: 0;
}

QListWidget#dialogsList::item:hover { background: rgba(123, 168, 255, 0.18); }

QListWidget#dialogsList::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(123, 168, 255, 0.32),
                                stop:1 rgba(200, 182, 255, 0.25));
    border: 1px solid rgba(123, 168, 255, 0.45);
}

QLabel#dialogTitle { color: #f2f2f7; font-size: 13.5px; font-weight: 700; }
QLabel#dialogTime { color: #9a9cae; font-size: 11.5px; }
QLabel#dialogPreview { color: #b6b8c8; font-size: 12px; }

QFrame#footerSeparator {
    background: rgba(255, 255, 255, 0.08);
    max-height: 1px;
    border: none;
}

QLabel#avatar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ffb6c1, stop:1 #c8b6ff);
    color: #ffffff;
    border-radius: 18px;
    font-weight: 700;
    font-size: 15px;
}

QLabel#userName { color: #f2f2f7; font-size: 13.5px; font-weight: 700; }
QLabel#userStatus { color: #9a9cae; font-size: 11.5px; }

QPushButton#iconButton {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #e6e8f2;
    border-radius: 10px;
    padding: 0;
}

QPushButton#iconButton:hover {
    background: rgba(123, 168, 255, 0.28);
    border-color: rgba(123, 168, 255, 0.55);
    color: #ffffff;
}

QWidget#chatToolbar {
    background: rgba(40, 40, 48, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
}

QLabel#chatTitle { color: #f2f2f7; font-size: 14px; font-weight: 700; }
QLabel#chatStatus { color: #a0a2b4; font-size: 12px; font-weight: 600; }

QFrame#toolbarSeparator {
    background: rgba(255, 255, 255, 0.08);
    max-height: 1px;
    border: none;
}

QWidget#settingsPanel {
    background: rgba(40, 40, 48, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
}

QLabel#settingsLabel { color: #a0a2b4; font-size: 12.5px; }

QLabel#settingsSectionTitle {
    color: #7a7d90;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding-top: 6px;
}

QLabel#modelMeta { color: #a0a2b4; font-size: 11.5px; padding-top: 2px; padding-left: 2px; }

QLabel#paramLabel { color: #f2f2f7; font-size: 13.5px; font-weight: 600; }

QLabel#paramValue {
    color: #9dbfff;
    font-size: 12.5px;
    font-weight: 700;
    background: rgba(123, 168, 255, 0.22);
    border-radius: 9px;
    padding: 3px 10px;
}

QLabel#paramHint { color: #a0a2b4; font-size: 11.5px; }

QComboBox#modelSelector {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 10px 14px;
    color: #f2f2f7;
    font-size: 14px;
    font-weight: 600;
    min-height: 22px;
}

QComboBox#modelSelector::drop-down { border: none; width: 28px; }

QComboBox#modelSelector::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #a0a2b4;
    width: 0; height: 0;
    margin-right: 10px;
}

QPlainTextEdit#systemPrompt {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 10px 12px;
    color: #e6e8f2;
    font-size: 13px;
}

QPushButton#primaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #8db6ff, stop:1 #6a97f2);
    color: #ffffff;
    border: none;
    border-radius: 13px;
    padding: 10px 16px;
    font-weight: 700;
    font-size: 13.5px;
}

QPushButton#secondaryButton {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 13px;
    padding: 9px 14px;
    color: #e6e8f2;
    font-weight: 600;
    font-size: 13px;
}

QPushButton#secondaryButton:hover {
    background: rgba(123, 168, 255, 0.18);
    border-color: rgba(123, 168, 255, 0.45);
}

QWidget#streamingRow {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
}

QFrame#modelInfoCard {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
}

QLabel#modelInfoName { color: #f2f2f7; font-size: 13.5px; font-weight: 700; }
QLabel#modelInfoStatus { color: #52d9a2; font-size: 12px; font-weight: 700; }

QFrame#modelInfoStat {
    background: rgba(123, 168, 255, 0.18);
    border: none;
    border-radius: 10px;
}

QLabel#modelInfoStatTitle { color: #a0a2b4; font-size: 11px; }
QLabel#modelInfoStatValue { color: #f2f2f7; font-size: 13px; font-weight: 700; }

QWidget#settingsOverlay {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1a1a1e, stop:0.5 #202026, stop:1 #1b2424);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
}

QLabel#dialogTitle { font-size: 18px; font-weight: 700; padding-bottom: 8px; color: #f2f2f7; }

QTabWidget#settingsTabs::pane {
    background: rgba(40, 40, 48, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 8px;
    top: -1px;
}

QTabWidget#settingsTabs QTabBar::tab {
    background: transparent;
    color: #a0a2b4;
    padding: 8px 16px;
    border-radius: 10px;
    margin-right: 4px;
    font-weight: 600;
    font-size: 13px;
}

QTabWidget#settingsTabs QTabBar::tab:selected {
    background: rgba(123, 168, 255, 0.28);
    color: #9dbfff;
}

QTabWidget#settingsTabs QTabBar::tab:hover:!selected {
    background: rgba(123, 168, 255, 0.14);
}

QPushButton#fileChip {
    background: rgba(123, 168, 255, 0.22);
    border: 1px solid rgba(123, 168, 255, 0.45);
    border-radius: 12px;
    padding: 6px 12px;
    font-size: 12.5px;
    font-weight: 600;
    color: #9dbfff;
}

QPushButton#fileChip:hover { background: rgba(123, 168, 255, 0.35); }

QPushButton#attachButton {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    padding: 0;
}

QPushButton#attachButton:hover {
    background: rgba(123, 168, 255, 0.28);
    border-color: rgba(123, 168, 255, 0.55);
}

QWidget#chipsRow { background: transparent; }

QPushButton#dialogMenuButton {
    background: transparent;
    border: none;
    color: #888;
    font-size: 16px;
    font-weight: bold;
    padding: 0;
    margin: 0;
}
QPushButton#dialogMenuButton:hover {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    color: #e8e8e8;
}
QMenu {
    background: #2a2a2a;
    color: #e8e8e8;
    border: 1px solid #444;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #3a3a3a;
}