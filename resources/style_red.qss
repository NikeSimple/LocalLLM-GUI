/* ============================================================
   LocalLLM-GUI — КРАСНАЯ ТЕМА
   ============================================================ */

QMainWindow, QWidget {
    font-family: "Inter", "Segoe UI", "Segoe UI Emoji", "Segoe UI Symbol", "SF Pro Display", sans-serif;
    font-size: 14px;
    color: #f5e6e6;
}

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1a0a0a, stop:0.5 #200e0e, stop:1 #1a0808);
}

QListWidget {
    background: rgba(60, 20, 20, 0.7);
    border: 1px solid rgba(230, 57, 70, 0.15);
    border-radius: 14px;
    padding: 6px;
    outline: none;
}

QListWidget::item { padding: 10px 12px; border-radius: 12px; color: #f5e6e6; }
QListWidget::item:hover { background: rgba(230, 57, 70, 0.18); }
QListWidget::item:selected { background: rgba(230, 57, 70, 0.35); color: #ffffff; }

QPushButton {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(230, 57, 70, 0.25);
    border-radius: 13px;
    padding: 10px 16px;
    color: #f5e6e6;
    font-weight: 600;
}

QPushButton:hover {
    background: rgba(230, 57, 70, 0.22);
    border-color: rgba(230, 57, 70, 0.6);
}

QPushButton:disabled {
    opacity: 0.4;
    background: rgba(255, 255, 255, 0.04);
    color: #8a5050;
}

QPushButton#sendButton, QPushButton#primaryButton, QPushButton#newDialogButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ef4444, stop:1 #b91c1c);
    color: #ffffff;
    border: none;
    font-weight: 700;
}

QPushButton#sendButton:hover, QPushButton#primaryButton:hover, QPushButton#newDialogButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #f87171, stop:1 #dc2626);
}

QPushButton#sendButton:disabled {
    background: rgba(160, 80, 80, 0.4);
    color: rgba(255, 255, 255, 0.5);
}

QPushButton#secondaryButton {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(230, 57, 70, 0.25);
    color: #f5e6e6;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(230, 57, 70, 0.2);
    border-radius: 12px;
    padding: 10px 12px;
    color: #f5e6e6;
    selection-background-color: rgba(230, 57, 70, 0.5);
}

QLineEdit:focus, QTextEdit:focus { border: 1px solid rgba(230, 57, 70, 0.7); }

QTextEdit#chatView {
    background: rgba(60, 20, 20, 0.75);
    border: 1px solid rgba(230, 57, 70, 0.15);
    border-radius: 18px;
    padding: 14px;
}

QComboBox {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(230, 57, 70, 0.25);
    border-radius: 12px;
    padding: 8px 12px;
    color: #f5e6e6;
}

QComboBox::drop-down { border: none; width: 24px; }

QComboBox QAbstractItemView {
    background: #2a1212;
    border: 1px solid rgba(230, 57, 70, 0.3);
    border-radius: 10px;
    color: #f5e6e6;
    selection-background-color: rgba(230, 57, 70, 0.35);
}

QSlider::groove:horizontal { height: 6px; background: rgba(230, 57, 70, 0.15); border-radius: 3px; }

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ef4444, stop:1 #b91c1c);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #ef4444;
    width: 18px; height: 18px;
    margin: -8px 0;
    border-radius: 9px;
}

QLabel { color: #f5e6e6; background: transparent; }

QLabel#settingsSectionTitle {
    color: #a87070;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

QLabel#paramValue {
    color: #f87171;
    background: rgba(230, 57, 70, 0.25);
    border-radius: 9px;
    padding: 3px 10px;
    font-weight: 700;
}

QLabel#paramHint, QLabel#settingsLabel { color: #a87070; }

QWidget#dialogListWidget, QWidget#settingsPanel {
    background: rgba(60, 20, 20, 0.85);
    border: 1px solid rgba(230, 57, 70, 0.15);
    border-radius: 24px;
}

QWidget#chatToolbar {
    background: rgba(60, 20, 20, 0.65);
    border: 1px solid rgba(230, 57, 70, 0.15);
    border-radius: 14px;
}

QFrame#modelInfoCard {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(230, 57, 70, 0.2);
    border-radius: 14px;
}

QFrame#modelInfoStat { background: rgba(230, 57, 70, 0.2); border: none; border-radius: 10px; }

QLabel#avatar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ef4444, stop:1 #7f1d1d);
    color: #ffffff;
    border-radius: 18px;
    font-weight: 700;
}

QPushButton#iconButton {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(230, 57, 70, 0.2);
    color: #f5e6e6;
    border-radius: 10px;
}

QPushButton#iconButton:hover {
    background: rgba(230, 57, 70, 0.3);
    color: #ffffff;
}

QStatusBar { background: rgba(20, 8, 8, 0.8); color: #a87070; }

QWidget#settingsOverlay {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1a0a0a, stop:0.5 #200e0e, stop:1 #1a0808);
    border: 1px solid rgba(230, 57, 70, 0.15);
    border-radius: 24px;
}

QTabWidget#settingsTabs::pane {
    background: rgba(60, 20, 20, 0.6);
    border: 1px solid rgba(230, 57, 70, 0.2);
    border-radius: 14px;
    padding: 8px;
}

QTabWidget#settingsTabs QTabBar::tab {
    background: transparent;
    color: #a87070;
    padding: 8px 16px;
    border-radius: 10px;
    margin-right: 4px;
    font-weight: 600;
}

QTabWidget#settingsTabs QTabBar::tab:selected {
    background: rgba(230, 57, 70, 0.35);
    color: #ffffff;
}

/* ТОНКАЯ ПОЛОСА ПРОКРУТКИ */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 6px 2px 6px 0;
}

QScrollBar::handle:vertical {
    background: rgba(239, 68, 68, 0.4);
    border-radius: 3px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(239, 68, 68, 0.7);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { height: 0px; background: transparent; }

QPushButton#fileChip {
    background: rgba(230, 57, 70, 0.25);
    border: 1px solid rgba(230, 57, 70, 0.5);
    border-radius: 12px;
    padding: 6px 12px;
    font-size: 12.5px;
    font-weight: 600;
    color: #f87171;
}

QPushButton#attachButton {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(230, 57, 70, 0.2);
    border-radius: 10px;
    padding: 0;
}

QPushButton#attachButton:hover {
    background: rgba(230, 57, 70, 0.3);
    border-color: rgba(230, 57, 70, 0.6);
}

QWidget#chipsRow { background: transparent; }

QPushButton#dialogMenuButton {
    background: transparent;
    border: none;
    color: #888;
    font-size: 16px;
    font-weight: bold;
    padding: 0;
    margin: 0;
}
QPushButton#dialogMenuButton:hover {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    color: #e8e8e8;
}
QMenu {
    background: #2a2a2a;
    color: #e8e8e8;
    border: 1px solid #444;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #3a3a3a;
}