/* ============================================================
   LocalLLM-GUI — ТЕМА ОКЕАН
   ============================================================ */

QMainWindow, QWidget {
    font-family: "Inter", "Segoe UI", "Segoe UI Emoji", "Segoe UI Symbol", "SF Pro Display", sans-serif;
    font-size: 14px;
    color: #e0f2f5;
}

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0a1420, stop:0.5 #0e1a26, stop:1 #0a1a20);
}

QListWidget {
    background: rgba(20, 40, 60, 0.7);
    border: 1px solid rgba(6, 182, 212, 0.15);
    border-radius: 14px;
    padding: 6px;
    outline: none;
}

QListWidget::item { padding: 10px 12px; border-radius: 12px; color: #e0f2f5; }
QListWidget::item:hover { background: rgba(6, 182, 212, 0.18); }
QListWidget::item:selected { background: rgba(6, 182, 212, 0.35); color: #ffffff; }

QPushButton {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(6, 182, 212, 0.25);
    border-radius: 13px;
    padding: 10px 16px;
    color: #e0f2f5;
    font-weight: 600;
}

QPushButton:hover {
    background: rgba(6, 182, 212, 0.22);
    border-color: rgba(6, 182, 212, 0.6);
}

QPushButton:disabled {
    opacity: 0.4;
    background: rgba(255, 255, 255, 0.04);
    color: #507080;
}

QPushButton#sendButton, QPushButton#primaryButton, QPushButton#newDialogButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #06b6d4, stop:1 #0891b2);
    color: #ffffff;
    border: none;
    font-weight: 700;
}

QPushButton#sendButton:hover, QPushButton#primaryButton:hover, QPushButton#newDialogButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #22d3ee, stop:1 #06b6d4);
}

QPushButton#sendButton:disabled {
    background: rgba(80, 130, 160, 0.4);
    color: rgba(255, 255, 255, 0.5);
}

QPushButton#secondaryButton {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(6, 182, 212, 0.25);
    color: #e0f2f5;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(6, 182, 212, 0.2);
    border-radius: 12px;
    padding: 10px 12px;
    color: #e0f2f5;
    selection-background-color: rgba(6, 182, 212, 0.5);
}

QLineEdit:focus, QTextEdit:focus { border: 1px solid rgba(6, 182, 212, 0.7); }

QTextEdit#chatView {
    background: rgba(20, 40, 60, 0.75);
    border: 1px solid rgba(6, 182, 212, 0.15);
    border-radius: 18px;
    padding: 14px;
}

QComboBox {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(6, 182, 212, 0.25);
    border-radius: 12px;
    padding: 8px 12px;
    color: #e0f2f5;
}

QComboBox::drop-down { border: none; width: 24px; }

QComboBox QAbstractItemView {
    background: #0e1a26;
    border: 1px solid rgba(6, 182, 212, 0.3);
    border-radius: 10px;
    color: #e0f2f5;
    selection-background-color: rgba(6, 182, 212, 0.35);
}

QSlider::groove:horizontal { height: 6px; background: rgba(6, 182, 212, 0.15); border-radius: 3px; }

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #06b6d4, stop:1 #0891b2);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #06b6d4;
    width: 18px; height: 18px;
    margin: -8px 0;
    border-radius: 9px;
}

QLabel { color: #e0f2f5; background: transparent; }

QLabel#settingsSectionTitle {
    color: #6a8fa0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

QLabel#paramValue {
    color: #22d3ee;
    background: rgba(6, 182, 212, 0.25);
    border-radius: 9px;
    padding: 3px 10px;
    font-weight: 700;
}

QLabel#paramHint, QLabel#settingsLabel { color: #6a8fa0; }

QWidget#dialogListWidget, QWidget#settingsPanel {
    background: rgba(20, 40, 60, 0.85);
    border: 1px solid rgba(6, 182, 212, 0.15);
    border-radius: 24px;
}

QWidget#chatToolbar {
    background: rgba(20, 40, 60, 0.65);
    border: 1px solid rgba(6, 182, 212, 0.15);
    border-radius: 14px;
}

QFrame#modelInfoCard {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(6, 182, 212, 0.2);
    border-radius: 14px;
}

QFrame#modelInfoStat { background: rgba(6, 182, 212, 0.2); border: none; border-radius: 10px; }

QLabel#avatar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #22d3ee, stop:1 #0e7490);
    color: #ffffff;
    border-radius: 18px;
    font-weight: 700;
}

QPushButton#iconButton {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(6, 182, 212, 0.2);
    color: #e0f2f5;
    border-radius: 10px;
}

QPushButton#iconButton:hover {
    background: rgba(6, 182, 212, 0.3);
    color: #ffffff;
}

QStatusBar { background: rgba(10, 20, 30, 0.8); color: #6a8fa0; }

QWidget#settingsOverlay {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0a1420, stop:0.5 #0e1a26, stop:1 #0a1a20);
    border: 1px solid rgba(6, 182, 212, 0.15);
    border-radius: 24px;
}

QTabWidget#settingsTabs::pane {
    background: rgba(20, 40, 60, 0.6);
    border: 1px solid rgba(6, 182, 212, 0.2);
    border-radius: 14px;
    padding: 8px;
}

QTabWidget#settingsTabs QTabBar::tab {
    background: transparent;
    color: #6a8fa0;
    padding: 8px 16px;
    border-radius: 10px;
    margin-right: 4px;
    font-weight: 600;
}

QTabWidget#settingsTabs QTabBar::tab:selected {
    background: rgba(6, 182, 212, 0.35);
    color: #ffffff;
}

/* ТОНКАЯ ПОЛОСА ПРОКРУТКИ */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 6px 2px 6px 0;
}

QScrollBar::handle:vertical {
    background: rgba(6, 182, 212, 0.4);
    border-radius: 3px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(6, 182, 212, 0.7);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { height: 0px; background: transparent; }

QPushButton#fileChip {
    background: rgba(6, 182, 212, 0.25);
    border: 1px solid rgba(6, 182, 212, 0.5);
    border-radius: 12px;
    padding: 6px 12px;
    font-size: 12.5px;
    font-weight: 600;
    color: #22d3ee;
}

QPushButton#attachButton {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(6, 182, 212, 0.2);
    border-radius: 10px;
    padding: 0;
}

QPushButton#attachButton:hover {
    background: rgba(6, 182, 212, 0.3);
    border-color: rgba(6, 182, 212, 0.6);
}

QWidget#chipsRow { background: transparent; }